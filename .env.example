# ---- Azure identity / ARM (personal tenant) ----
AZURE_TENANT_ID=379bc25f-3328-4548-a99f-41ef31905732
AZURE_SUBSCRIPTION_ID=961d5838-fa9f-4a0a-837a-268292eabc92
AZURE_RESOURCE_GROUP=my-aiverse
FOUNDRY_ACCOUNT=my-model-hub

# ---- Azure OpenAI (the account's model deployments; AOAI_API_KEY empty = use the signed-in identity) ----
AOAI_ENDPOINT=https://my-model-hub.openai.azure.com
AOAI_API_KEY=
AOAI_API_VERSION=2025-04-01-preview
EMBED_DEPLOYMENT=text-embedding-3-large
EMBED_DIMS=3072
DEFAULT_CHAT_MODEL=gpt-4.1-mini
ROUTER_MODEL=gpt-4.1-mini

# ---- Azure AI Search (filled by infra/03-env.sh) ----
SEARCH_SERVICE_NAME=
SEARCH_ENDPOINT=
SEARCH_ADMIN_KEY=
SEARCH_QUERY_KEY=
SEARCH_INDEX=bank-products
SEARCH_API_VERSION=2026-08-01-preview

# ---- Knowledge base behaviour ----
# minimal = extractive retrieval, no LLM inside the KB (works on Free tier)
# low     = LLM query planning inside the KB (key-based; may be rejected on Free tier)
KB_REASONING_EFFORT=minimal
KB_LLM_DEPLOYMENT=gpt-4.1-mini
# how the app authenticates to the knowledge base MCP endpoint: identity (your az login / the container's managed
# identity, needs Search Index Data Reader on the search service) | apikey (SEARCH_QUERY_KEY, POC fallback)
KB_MCP_AUTH=identity
# router: a routing model picks the skill | supervisor: a concierge model hands off to a specialist in-process
ORCHESTRATION_MODE=router
# earlier question/answer pairs the agent sees per turn; older ones are replaced by a short recap
HISTORY_TURNS=6
# Optional cap on retrieval context per call (service tokens). 0 = off. NOTE: measured on Thai text this cap *increased* returned chunks; prefer top_k.
KB_MAX_OUTPUT_TOKENS=0

# ---- App ----
SKILLS_DIR=skills
KNOWLEDGE_DIR=knowledge
RULES_DIR=rules
STATE_DIR=.state
API_PORT=8010
# Studio (tester page at /studio): HTTP basic auth, any username + this password. Empty = Studio disabled.
STUDIO_PASSWORD=
# Name shown in the mobile greeting
APP_USER_NAME=Pim
APP_USER_INITIALS=PW
ASSISTANT_NAME=เกรส

# Studio access by Entra identity (Easy Auth). Comma-separated emails. Admins manage the list in Settings > Access;
# testers get every other tab; externals get a chat web page only (no Studio tabs).
# Without SSO (local dev) STUDIO_PASSWORD grants admin.
STUDIO_ADMINS=
STUDIO_TESTERS=
STUDIO_EXTERNALS=

# bangkokbank.com public API (live FX rates + branch locator). The value the site sends with its own calls; POC uses it
# directly, replace with a dedicated POC subscription for production. Leave blank to disable the FX / branch tools.
BBL_API_KEY=
# BBL_API_BASE=https://www.bangkokbank.com/api

# The live-service tools (fx_rate, find_branch) are called in-process by the agents. /mcp/services exposes the same
# tools to external MCP clients; in Azure run infra/13-services-tool.sh, which sets PUBLIC_BASE_URL and the allowed
# callers (the endpoint stays behind Easy Auth).
PUBLIC_BASE_URL=
# other names this app answers on, comma separated - only needed while moving to a custom domain
PUBLIC_BASE_ALIASES=
# optional: with a key a place card embeds a map, without one it links out to the customer's map app
GOOGLE_MAPS_KEY=
# object ids (comma separated) allowed to call /mcp/services through Easy Auth; empty = the endpoint is not mounted
MCP_CALLER_PRINCIPALS=
# Local dev only (no Easy Auth to authenticate anyone): a shared header key instead of the identity check.
MCP_TOOL_KEY=
